# Nạp tự động khi chạy "vite build" (mode mặc định của build là "production").
# VITE_API_URL PHẢI để RỖNG (có key, không có giá trị) — Vite inline biến này lúc BUILD,
# không phải lúc chạy, nên không thể sửa sau khi đã build image.
# Rỗng nghĩa là mọi request của FE dùng đường dẫn tương đối (/api/..., /ws, /oauth2/...)
# và được Nginx (cùng origin, xem nginx/nginx.conf) proxy sang backend:8080.
# KHÔNG đổi thành http://localhost:8080 ở đây — làm vậy sẽ vỡ khi build ra image Docker.
VITE_API_URL=

# Map (Goong) — cần baked vào bundle production để tính năng bản đồ hoạt động.
VITE_GOONG_MAPTILES_KEY=vDjD4QcSyzhC66t59iBBK8ZhRGzUTwEFsat16jbG
VITE_GOONG_API_KEY=wyhX8DQA8ZgJdYysmD3PARo1i1aE8wvv44xoZvUV
